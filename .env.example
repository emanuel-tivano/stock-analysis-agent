# Safe defaults. Copy to .env; never commit credentials.
MARKET_TRACKER_BASE_URL=https://argentina-market-tracker.vercel.app
MARKET_QUOTE_ENRICHMENT=true
MARKET_QUOTE_POLICY=include_provisional_ohlc
# history_only conserva una quote nueva separada, sin incorporarla a indicadores.
LLM_DETERMINISTIC_FALLBACK=true
LLM_MAX_RETRY_WAIT_SECONDS=30
HTTP_TIMEOUT_SECONDS=20
STALE_AFTER_DAYS=7
MAX_AGENT_STEPS=12
# Local default. In Vercel, DATABASE_URL selects durable PostgreSQL instead.
DATABASE_PATH=data/sessions.sqlite3
DATABASE_URL=
# Optional dedicated local database for the opt-in PostgreSQL contract test.
TEST_DATABASE_URL=
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_RESPONSE_FORMAT=json_object
AGENT_PROMPT_VERSION=technical-v3
# Optional cost accounting: omit until prices are verified for the chosen model.
# LLM_INPUT_PRICE_PER_1M=
# LLM_OUTPUT_PRICE_PER_1M=
# External LLM tests require an explicit process environment opt-in:
# RUN_LLM_TESTS=1
